    "@meshtastic/core": "^2.6.7",
    "@meshtastic/protobufs": "^2.8.0",
    "@meshtastic/transport-http": "^0.2.5",
    "@meshtastic/transport-web-bluetooth": "^0.1.5",
    "@meshtastic/transport-web-serial": "^0.2.5",
    "esptool-js": "^0.7.1"
  },
  "devDependencies": {
    "vite": "^8.4.0"
  },
  "type": "module"
}
